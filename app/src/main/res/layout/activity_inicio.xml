<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pantalla"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".Inicio">

    <LinearLayout
        style="@style/Encabezado"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtFecha"
                style="@style/Subtitulo"
                tools:text="Miércoles 30 de septiembre" />

            <TextView
                android:id="@+id/txtSaludo"
                style="@style/Titulo"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Hola 👋"
                tools:text="Hola, Ana 👋" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnNotificaciones"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_translucido"
            android:contentDescription="Notificaciones">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campana_header"
                app:tint="@color/white" />

            <View
                android:id="@+id/puntoAviso"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="25dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_punto_aviso" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tarjetaGemini"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_gemini"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chispa"
                app:tint="@color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="Consejo de estudio · Gemini"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/btnOtroConsejo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_translucido"
                android:contentDescription="Otro consejo"
                android:padding="8dp"
                android:src="@drawable/ic_recargar"
                app:tint="@color/white" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtConsejo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3dp"
            android:maxLines="5"
            android:ellipsize="end"
            android:text="Gemini está preparando un consejo para ti..."
            android:textColor="@color/white"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAbrirAsistente"
            style="@style/BotonGemini"
            android:layout_marginTop="10dp"
            android:text="Preguntar a Gemini"
            app:icon="@drawable/ic_chispa" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:fontFamily="sans-serif-black"
                android:text="Mis canales"
                android:textColor="@color/texto"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/chipTodos"
                style="@style/Chip"
                android:text="Todos" />

            <TextView
                android:id="@+id/chipNoLeidos"
                style="@style/Chip"
                android:text="No leídos" />

            <TextView
                android:id="@+id/chipMaterias"
                style="@style/Chip"
                android:text="Materias" />

            <TextView
                android:id="@+id/chipAvisos"
                style="@style/Chip"
                android:text="Avisos" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lvCanales"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="12dp"
            android:paddingStart="20dp"
            android:paddingTop="4dp"
            android:paddingEnd="20dp"
            android:paddingBottom="96dp"
            android:scrollbarStyle="outsideOverlay" />

        <TextView
            android:id="@+id/txtVacio"
            style="@style/EstadoVacio"
            android:text="Aún no tienes canales"
            android:visibility="gone" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/btnAgregar"
            style="@style/Fab"
            android:contentDescription="Nueva tarea"
            android:text="Nueva tarea" />
    </FrameLayout>

    <include layout="@layout/barra_navegacion" />

</LinearLayout>
