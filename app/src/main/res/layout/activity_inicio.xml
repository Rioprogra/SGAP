<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pantalla"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".Inicio">

    <LinearLayout
        style="@style/Encabezado"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtFecha"
                style="@style/Subtitulo"
                tools:text="Miércoles 30 de septiembre" />

            <TextView
                android:id="@+id/txtSaludo"
                style="@style/Titulo"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Hola 👋"
                tools:text="Hola, Ana 👋" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnNotificaciones"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_translucido"
            android:contentDescription="Notificaciones">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campana_header"
                app:tint="@color/white" />

            <View
                android:id="@+id/puntoAviso"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="25dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_punto_aviso" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:text="Mis tareas"
            android:textColor="@color/texto"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/txtResumen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_suave"
            android:textSize="13sp"
            tools:text="2 por entregar" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/chipPendientes"
                style="@style/Chip"
                android:text="Por entregar" />

            <TextView
                android:id="@+id/chipSemana"
                style="@style/Chip"
                android:text="Esta semana" />

            <TextView
                android:id="@+id/chipVencidas"
                style="@style/Chip"
                android:text="Vencidas" />

            <TextView
                android:id="@+id/chipEntregadas"
                style="@style/Chip"
                android:text="Entregadas" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lvTareas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="10dp"
            android:paddingStart="20dp"
            android:paddingTop="6dp"
            android:paddingEnd="20dp"
            android:paddingBottom="96dp"
            android:scrollbarStyle="outsideOverlay" />

        <TextView
            android:id="@+id/txtVacio"
            style="@style/EstadoVacio"
            android:text="No tienes tareas por entregar 🎉"
            android:visibility="gone" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/btnAgregar"
            style="@style/Fab"
            android:contentDescription="Nueva tarea"
            android:text="Nueva tarea" />
    </FrameLayout>

    <include layout="@layout/barra_navegacion" />

</LinearLayout>
