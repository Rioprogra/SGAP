<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pantalla"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".Pendientes">

    <LinearLayout style="@style/EncabezadoBarra">

        <TextView
            android:id="@+id/btnRegresar"
            style="@style/Regresar" />

        <TextView
            style="@style/TituloBarra"
            android:text="Pendientes" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TituloSeccion"
                    android:text="Notificaciones" />

                <TextView
                    android:id="@+id/txtMarcarLeidas"
                    style="@style/LinkSeccion"
                    android:text="Marcar como leídas" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/contNotificaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/txtSinNotificaciones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:text="No tienes notificaciones nuevas"
                android:textColor="@color/texto_suave"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TituloSeccion"
                    android:text="Por entregar" />

                <TextView
                    android:id="@+id/txtVerTodo"
                    style="@style/LinkSeccion"
                    android:text="Ver todo" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipTodas"
                        style="@style/Chip"
                        android:text="Todas" />

                    <TextView
                        android:id="@+id/chipTarea"
                        style="@style/Chip"
                        android:text="Tarea" />

                    <TextView
                        android:id="@+id/chipExamen"
                        style="@style/Chip"
                        android:text="Examen" />

                    <TextView
                        android:id="@+id/chipProyecto"
                        style="@style/Chip"
                        android:text="Proyecto" />

                    <TextView
                        android:id="@+id/chipVencidas"
                        style="@style/Chip"
                        android:text="Vencidas" />

                    <TextView
                        android:id="@+id/chipEntregadas"
                        style="@style/Chip"
                        android:text="Entregadas" />
                </LinearLayout>
            </HorizontalScrollView>

            <Spinner
                android:id="@+id/spFiltroMateria"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_campo"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <LinearLayout
                android:id="@+id/contPendientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/txtSinPendientes"
                style="@style/EstadoVacio"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:text="¡Todo al día! No tienes nada por entregar"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNuevaTarea"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="Nueva tarea"
                android:textAllCaps="false"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_agregar"
                app:iconGravity="textStart" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
