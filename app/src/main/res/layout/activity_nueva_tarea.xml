<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pantalla"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".NuevaTarea">

    <LinearLayout style="@style/EncabezadoBarra">

        <TextView
            android:id="@+id/btnRegresar"
            style="@style/Regresar" />

        <TextView
            android:id="@+id/txtTituloPantalla"
            style="@style/TituloBarra"
            android:text="Nueva tarea" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="20dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp">

            <TextView
                style="@style/Etiqueta"
                android:text="Título" />

            <EditText
                android:id="@+id/txtTitulo"
                style="@style/Campo"
                android:hint="Ej. Tarea de Base de Datos"
                android:inputType="textCapSentences"
                android:maxLength="80" />

            <TextView
                style="@style/Etiqueta"
                android:layout_marginTop="20dp"
                android:text="Tipo" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/opTarea"
                    style="@style/Opcion"
                    android:text="Tarea" />

                <TextView
                    android:id="@+id/opExamen"
                    style="@style/Opcion"
                    android:layout_marginStart="8dp"
                    android:text="Examen" />

                <TextView
                    android:id="@+id/opProyecto"
                    style="@style/Opcion"
                    android:layout_marginStart="8dp"
                    android:text="Proyecto" />
            </LinearLayout>

            <TextView
                style="@style/Etiqueta"
                android:layout_marginTop="20dp"
                android:text="Materia" />

            <Spinner
                android:id="@+id/spMateria"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_campo"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <TextView
                android:id="@+id/lblPara"
                style="@style/Etiqueta"
                android:layout_marginTop="20dp"
                android:text="¿Para quién?" />

            <Spinner
                android:id="@+id/spPara"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_campo"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <TextView
                style="@style/Etiqueta"
                android:layout_marginTop="20dp"
                android:text="Fecha de entrega" />

            <TextView
                android:id="@+id/txtFecha"
                style="@style/Campo"
                android:hint="Seleccionar fecha" />

            <TextView
                style="@style/Etiqueta"
                android:layout_marginTop="20dp"
                android:text="Descripción (opcional)" />

            <EditText
                android:id="@+id/txtDescripcion"
                style="@style/Campo"
                android:gravity="top"
                android:hint="Agrega detalles"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="300"
                android:minHeight="112dp" />

            <LinearLayout
                android:id="@+id/tarjetaGemini"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_gemini"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chispa"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-black"
                        android:text="Asistente Gemini"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <ProgressBar
                        android:id="@+id/progresoIA"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:indeterminateTint="@color/white"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Escribe el título y deja que la IA te ayude"
                    android:textColor="@color/sobre_primario_suave"
                    android:textSize="13sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSugerirIA"
                            style="@style/BotonGemini"
                            android:text="Descripción"
                            app:icon="@drawable/ic_descripcion" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPrioridadIA"
                            style="@style/BotonGemini"
                            android:text="Prioridad"
                            app:icon="@drawable/ic_bandera" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPlanIA"
                            style="@style/BotonGemini"
                            android:text="Plan de estudio"
                            app:icon="@drawable/ic_lista" />
                    </LinearLayout>
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/txtResultadoIA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_burbuja_ia"
                    android:lineSpacingExtra="3dp"
                    android:padding="14dp"
                    android:textColor="@color/texto"
                    android:textIsSelectable="true"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUsarResultado"
                    style="@style/BotonGemini"
                    android:layout_marginTop="8dp"
                    android:text="Agregar a la descripción"
                    android:visibility="gone"
                    app:icon="@drawable/ic_agregar" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnEliminar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_opcion"
                android:gravity="center"
                android:text="Eliminar tarea"
                android:textColor="@color/error"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnGuardar"
        style="@style/BotonPrimario"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="20dp"
        android:text="Guardar tarea" />

</LinearLayout>
