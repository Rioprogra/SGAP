<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".NuevaTarea">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/btnRegresar"
            style="@style/Regresar" />

        <TextView
            android:id="@+id/txtTituloPantalla"
            style="@style/TituloBarra"
            android:text="Nueva tarea" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp">

            <TextView
                style="@style/Etiqueta"
                android:text="Título" />

            <EditText
                android:id="@+id/txtTitulo"
                style="@style/Campo"
                android:hint="Ej. Tarea de Base de Datos"
                android:inputType="textCapSentences"
                android:maxLength="80" />

            <TextView
                style="@style/Etiqueta"
                android:layout_marginTop="20dp"
                android:text="Tipo" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/opTarea"
                    style="@style/Opcion"
                    android:text="Tarea" />

                <TextView
                    android:id="@+id/opExamen"
                    style="@style/Opcion"
                    android:layout_marginStart="8dp"
                    android:text="Examen" />

                <TextView
                    android:id="@+id/opProyecto"
                    style="@style/Opcion"
                    android:layout_marginStart="8dp"
                    android:text="Proyecto" />
            </LinearLayout>

            <TextView
                style="@style/Etiqueta"
                android:layout_marginTop="20dp"
                android:text="Materia" />

            <Spinner
                android:id="@+id/spMateria"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_campo"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <TextView
                android:id="@+id/lblPara"
                style="@style/Etiqueta"
                android:layout_marginTop="20dp"
                android:text="¿Para quién?" />

            <Spinner
                android:id="@+id/spPara"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_campo"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <TextView
                style="@style/Etiqueta"
                android:layout_marginTop="20dp"
                android:text="Fecha de entrega" />

            <TextView
                android:id="@+id/txtFecha"
                style="@style/Campo"
                android:hint="Seleccionar fecha" />

            <TextView
                style="@style/Etiqueta"
                android:layout_marginTop="20dp"
                android:text="Descripción (opcional)" />

            <EditText
                android:id="@+id/txtDescripcion"
                style="@style/Campo"
                android:gravity="top"
                android:hint="Agrega detalles"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="300"
                android:minHeight="112dp" />

            <TextView
                android:id="@+id/btnSugerirIA"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:text="✨ Sugerir descripción con IA"
                android:textColor="@color/primario"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnEliminar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_opcion"
                android:gravity="center"
                android:text="Eliminar tarea"
                android:textColor="@color/error"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnGuardar"
        style="@style/BotonPrimario"
        android:layout_margin="24dp"
        android:text="Guardar tarea" />

</LinearLayout>
