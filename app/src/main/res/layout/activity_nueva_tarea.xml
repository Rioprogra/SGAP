<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla para agregar una tarea, examen o proyecto (Figma: Nueva tarea) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".NuevaTarea">

    <!-- Barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/btnRegresar"
            style="@style/Regresar" />

        <TextView
            style="@style/TituloBarra"
            android:text="Nueva tarea" />
    </LinearLayout>

    <!-- Formulario (con scroll para cuando sale el teclado) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp">

            <TextView
                style="@style/Etiqueta"
                android:text="Título" />

            <EditText
                android:id="@+id/txtTitulo"
                style="@style/Campo"
                android:hint="Ej. Tarea de Base de Datos"
                android:inputType="textCapSentences" />

            <TextView
                style="@style/Etiqueta"
                android:layout_marginTop="20dp"
                android:text="Tipo" />

            <!-- Tres botones en vez del RadioGroup. Solo uno puede estar elegido -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/opTarea"
                    style="@style/Opcion"
                    android:text="Tarea" />

                <TextView
                    android:id="@+id/opExamen"
                    style="@style/Opcion"
                    android:layout_marginStart="8dp"
                    android:text="Examen" />

                <TextView
                    android:id="@+id/opProyecto"
                    style="@style/Opcion"
                    android:layout_marginStart="8dp"
                    android:text="Proyecto" />
            </LinearLayout>

            <TextView
                style="@style/Etiqueta"
                android:layout_marginTop="20dp"
                android:text="Fecha de entrega" />

            <!-- Parece campo de texto, pero al tocarlo abre el calendario -->
            <TextView
                android:id="@+id/txtFecha"
                style="@style/Campo"
                android:hint="Seleccionar fecha" />

            <TextView
                style="@style/Etiqueta"
                android:layout_marginTop="20dp"
                android:text="Descripción (opcional)" />

            <EditText
                android:id="@+id/txtDescripcion"
                style="@style/Campo"
                android:gravity="top"
                android:hint="Agrega detalles"
                android:inputType="textMultiLine|textCapSentences"
                android:minHeight="112dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Pie con el boton -->
    <Button
        android:id="@+id/btnGuardar"
        style="@style/BotonPrimario"
        android:layout_margin="24dp"
        android:text="Guardar tarea" />

</LinearLayout>
