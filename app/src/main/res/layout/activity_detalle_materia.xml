<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pantalla"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".DetalleMateria">

    <LinearLayout style="@style/EncabezadoBarra">

        <TextView
            android:id="@+id/btnRegresar"
            style="@style/Regresar" />

        <TextView
            android:id="@+id/txtTitulo"
            style="@style/TituloBarra"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Materia" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tarjeta"
                android:elevation="2dp"
                android:orientation="horizontal"
                android:padding="18dp">

                <View
                    android:id="@+id/barraColor"
                    android:layout_width="6dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_barra_tipo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtNombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/texto"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/txtProfesor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/texto"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/txtHoras"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/texto_suave"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/TituloSeccion"
                android:layout_width="match_parent"
                android:layout_marginTop="24dp"
                android:text="Horario" />

            <LinearLayout
                android:id="@+id/contHorario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/TituloSeccion"
                android:layout_width="match_parent"
                android:layout_marginTop="24dp"
                android:text="Tareas, exámenes y proyectos" />

            <LinearLayout
                android:id="@+id/contTareas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/txtSinTareas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="No hay tareas de esta materia 🎉"
                android:textColor="@color/texto_suave"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnNuevaTarea"
                style="@style/BotonPrimario"
                android:layout_marginTop="20dp"
                android:text="Agregar tarea de esta materia" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
