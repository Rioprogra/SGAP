<?xml version="1.0" encoding="utf-8"?>
<!-- Pestana Perfil (no esta en el Figma: version sencilla con el mismo estilo) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".Perfil">

    <!-- Encabezado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <TextView
            style="@style/Subtitulo"
            android:text="Tu cuenta" />

        <TextView
            style="@style/Titulo"
            android:text="Perfil" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- Tarjeta con tus datos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tarjeta"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/txtIniciales"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_circulo"
                    android:backgroundTint="@color/primario"
                    android:gravity="center"
                    android:textColor="@color/sobre_primario"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="AL" />

                <TextView
                    android:id="@+id/txtNombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/texto"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Ana López" />

                <TextView
                    android:id="@+id/txtCorreo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/texto_suave"
                    android:textSize="13sp"
                    tools:text="20231234@utcj.edu.mx" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_etiqueta"
                    android:backgroundTint="@color/fondo"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="Ingeniería en Software · 5°A"
                    android:textColor="@color/primario"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Numeritos: pendientes, grupos y canales -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/Dato"
                    android:id="@+id/datoPendientes">

                    <TextView
                        android:id="@+id/txtNumPendientes"
                        style="@style/DatoNumero" />

                    <TextView
                        style="@style/DatoTexto"
                        android:text="Pendientes" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Dato"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:id="@+id/txtNumGrupos"
                        style="@style/DatoNumero" />

                    <TextView
                        style="@style/DatoTexto"
                        android:text="Mis grupos" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Dato"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:id="@+id/txtNumCanales"
                        style="@style/DatoNumero" />

                    <TextView
                        style="@style/DatoTexto"
                        android:text="Canales" />
                </LinearLayout>
            </LinearLayout>

            <!-- Opciones -->
            <TextView
                android:id="@+id/btnMisPendientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_tarjeta"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp"
                android:text="Ver mis pendientes  →"
                android:textColor="@color/texto"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/btnCerrarSesion"
                style="@style/BotonPrimario"
                android:layout_marginTop="24dp"
                android:text="Cerrar sesión" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/barra_navegacion" />

</LinearLayout>
