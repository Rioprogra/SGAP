<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pantalla"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".Perfil">

    <LinearLayout
        style="@style/Encabezado"
        android:orientation="vertical">

        <TextView
            style="@style/Subtitulo"
            android:text="Tu cuenta" />

        <TextView
            style="@style/Titulo"
            android:text="Perfil" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tarjeta"
                android:elevation="4dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/txtIniciales"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_gemini_circulo"
                    android:elevation="4dp"
                    android:gravity="center"
                    android:textColor="@color/sobre_primario"
                    android:textSize="28sp"
                    android:fontFamily="sans-serif-black"
                    tools:text="AL" />

                <TextView
                    android:id="@+id/txtNombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/texto"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Ana López" />

                <TextView
                    android:id="@+id/txtCorreo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/texto_suave"
                    android:textSize="13sp"
                    tools:text="20231234@utcj.edu.mx" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_etiqueta"
                    android:backgroundTint="@color/secundario_suave"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="Ingeniería en Software · 5°A"
                    android:textColor="@color/secundario"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/Dato"
                    android:id="@+id/datoPendientes">

                    <TextView
                        android:id="@+id/txtNumPendientes"
                        style="@style/DatoNumero" />

                    <TextView
                        style="@style/DatoTexto"
                        android:text="Pendientes" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Dato"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:id="@+id/txtNumGrupos"
                        style="@style/DatoNumero" />

                    <TextView
                        style="@style/DatoTexto"
                        android:text="Mis grupos" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Dato"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:id="@+id/txtNumCanales"
                        style="@style/DatoNumero" />

                    <TextView
                        style="@style/DatoTexto"
                        android:text="Canales" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/btnMisPendientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_tarjeta"
                android:drawableStart="@drawable/ic_lista"
                android:drawableEnd="@drawable/ic_flecha"
                android:drawablePadding="14dp"
                android:drawableTint="@color/primario"
                android:elevation="2dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingTop="18dp"
                android:paddingEnd="16dp"
                android:paddingBottom="18dp"
                android:text="Mis pendientes"
                android:textColor="@color/texto"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btnProgreso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_tarjeta"
                android:drawableStart="@drawable/ic_grafica"
                android:drawableEnd="@drawable/ic_flecha"
                android:drawablePadding="14dp"
                android:drawableTint="@color/primario"
                android:elevation="2dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingTop="18dp"
                android:paddingEnd="16dp"
                android:paddingBottom="18dp"
                android:text="Progreso por materia"
                android:textColor="@color/texto"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btnAsistentePerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_tarjeta"
                android:drawableStart="@drawable/ic_chispa"
                android:drawableEnd="@drawable/ic_flecha"
                android:drawablePadding="14dp"
                android:drawableTint="@color/primario"
                android:elevation="2dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingTop="18dp"
                android:paddingEnd="16dp"
                android:paddingBottom="18dp"
                android:text="Asistente IA con Gemini"
                android:textColor="@color/texto"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_tarjeta"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_luna"
                    android:drawablePadding="14dp"
                    android:drawableTint="@color/primario"
                    android:gravity="center_vertical"
                    android:fontFamily="sans-serif-medium"
                    android:text="Modo oscuro"
                    android:textColor="@color/texto"
                    android:textSize="15sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swModoOscuro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCerrarSesion"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="Cerrar sesión"
                android:textAllCaps="false"
                android:textColor="@color/error"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_salir"
                app:iconGravity="textStart"
                app:iconTint="@color/error"
                app:strokeColor="@color/error" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/barra_navegacion" />

</LinearLayout>
