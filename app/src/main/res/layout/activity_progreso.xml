<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pantalla"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".Progreso">

    <LinearLayout style="@style/EncabezadoBarra">

        <TextView
            android:id="@+id/btnRegresar"
            style="@style/Regresar" />

        <TextView
            style="@style/TituloBarra"
            android:text="Progreso por materia" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/contProgreso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/txtVacio"
                style="@style/EstadoVacio"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="40dp"
                android:text="Aún no tienes tareas para medir tu progreso"
                android:textColor="@color/texto_suave"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
