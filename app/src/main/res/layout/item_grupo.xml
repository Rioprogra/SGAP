<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tarjeta"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtSiglas"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icono"
            android:gravity="center"
            android:textColor="@color/primario"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/texto"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/texto_suave"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtEtiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_etiqueta"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/avatar1"
            style="@style/Avatar" />

        <TextView
            android:id="@+id/avatar2"
            style="@style/Avatar"
            android:layout_marginStart="-8dp" />

        <TextView
            android:id="@+id/avatar3"
            style="@style/Avatar"
            android:layout_marginStart="-8dp" />

        <TextView
            android:id="@+id/avatar4"
            style="@style/Avatar"
            android:layout_marginStart="-8dp" />

        <TextView
            android:id="@+id/txtIntegrantes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/texto_suave"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
