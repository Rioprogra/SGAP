<?xml version="1.0" encoding="utf-8"?>
<!-- Pestana Grupo: equipos y grupos de estudio (Figma: Grupo) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".Grupo">

    <!-- Encabezado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <TextView
            style="@style/Subtitulo"
            android:text="Ingeniería en Software · 5°A" />

        <TextView
            style="@style/Titulo"
            android:text="Grupos del salón" />
    </LinearLayout>

    <!-- Filtros -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/chipTodos"
                style="@style/Chip"
                android:text="Todos" />

            <TextView
                android:id="@+id/chipProyecto"
                style="@style/Chip"
                android:text="Proyecto" />

            <TextView
                android:id="@+id/chipEstudio"
                style="@style/Chip"
                android:text="Estudio" />

            <TextView
                android:id="@+id/chipConLugar"
                style="@style/Chip"
                android:text="Con lugar" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Lista + boton "+" encima -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- paddingBottom grande para que el "+" no tape la ultima tarjeta -->
        <ListView
            android:id="@+id/lvGrupos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="12dp"
            android:paddingStart="24dp"
            android:paddingTop="4dp"
            android:paddingEnd="24dp"
            android:paddingBottom="96dp"
            android:scrollbarStyle="outsideOverlay" />

        <TextView
            android:id="@+id/txtVacio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="No hay grupos con este filtro"
            android:textColor="@color/texto_suave"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnAgregar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_boton_agregar"
            android:contentDescription="Crear grupo"
            android:elevation="6dp"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/sobre_primario"
            android:textSize="30sp" />
    </FrameLayout>

    <include layout="@layout/barra_navegacion" />

</LinearLayout>
