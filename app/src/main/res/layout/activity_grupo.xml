<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pantalla"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".Grupo">

    <LinearLayout
        style="@style/Encabezado"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtSubtitulo"
            style="@style/Subtitulo"
            android:text="Tu salón" />

        <TextView
            android:id="@+id/txtNombreGrupo"
            style="@style/Titulo"
            android:text="Mi grupo" />

        <TextView
            android:id="@+id/txtInfoGrupo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/sobre_primario_suave"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Código: K7M2Q9XA · Tutor · 24 integrantes" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/scrollGrupos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/contChipsGrupos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/txtTituloMaterias"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:text="Materias"
        android:textColor="@color/texto"
        android:textSize="18sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lvMaterias"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="10dp"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="96dp"
            android:scrollbarStyle="outsideOverlay" />

        <LinearLayout
            android:id="@+id/contVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtVacio"
                style="@style/EstadoVacio"
                android:text="Aún no estás en un grupo." />

            <Button
                android:id="@+id/btnCargarHorario"
                style="@style/BotonPrimario"
                android:layout_marginTop="20dp"
                android:text="Cargar horario con foto"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/btnAgregar"
            style="@style/Fab"
            android:contentDescription="Unirme con código"
            android:text="Unirme con código" />
    </FrameLayout>

    <include layout="@layout/barra_navegacion" />

</LinearLayout>
