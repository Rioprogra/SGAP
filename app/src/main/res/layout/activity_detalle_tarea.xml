<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pantalla"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".DetalleTarea">

    <LinearLayout style="@style/EncabezadoBarra">

        <TextView
            android:id="@+id/btnRegresar"
            style="@style/Regresar" />

        <TextView
            style="@style/TituloBarra"
            android:text="Detalle" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="20dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/txtCargando"
                style="@style/EstadoVacio"
                android:layout_marginTop="48dp"
                android:text="Cargando tarea..." />

            <LinearLayout
                android:id="@+id/contDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tarjeta"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtTipo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_etiqueta"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/texto"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/txtEstado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="14sp" />

                <TextView
                    style="@style/Etiqueta"
                    android:layout_marginTop="20dp"
                    android:text="Fecha de entrega" />

                <TextView
                    android:id="@+id/txtFecha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:textColor="@color/texto"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/lblMateria"
                    style="@style/Etiqueta"
                    android:layout_marginTop="16dp"
                    android:text="Materia" />

                <TextView
                    android:id="@+id/txtMateria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:textColor="@color/texto"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/lblGrupo"
                    style="@style/Etiqueta"
                    android:layout_marginTop="16dp"
                    android:text="Grupo" />

                <TextView
                    android:id="@+id/txtGrupo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:textColor="@color/texto"
                    android:textSize="16sp" />

                <TextView
                    style="@style/Etiqueta"
                    android:layout_marginTop="16dp"
                    android:text="Descripción" />

                <TextView
                    android:id="@+id/txtDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/texto"
                    android:textIsSelectable="true"
                    android:textSize="16sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnEntregar"
                style="@style/BotonPrimario"
                android:layout_marginTop="20dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnEditar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_opcion"
                android:gravity="center"
                android:text="Editar tarea"
                android:textColor="@color/primario"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
