<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pantalla"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".Registro">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            style="@style/Encabezado"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="28dp"
            android:paddingBottom="60dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_circulo"
                android:contentDescription="Logo de StudyGest"
                android:elevation="6dp"
                android:padding="14dp"
                android:src="@drawable/logo_studygest" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-black"
                android:text="Crear cuenta"
                android:textColor="@color/white"
                android:textSize="28sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Usa tu correo de la escuela"
                android:textColor="@color/sobre_primario_suave"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="-40dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_tarjeta"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="22dp">

        <TextView
            style="@style/Etiqueta"
            android:text="Nombre" />

        <EditText
            android:id="@+id/txtNombre"
            style="@style/Campo"
            android:hint="Ej. Ana"
            android:inputType="textPersonName|textCapWords" />

        <TextView
            style="@style/Etiqueta"
            android:layout_marginTop="16dp"
            android:text="Apellidos" />

        <EditText
            android:id="@+id/txtApellidos"
            style="@style/Campo"
            android:hint="Ej. López García"
            android:inputType="textPersonName|textCapWords" />

        <TextView
            style="@style/Etiqueta"
            android:layout_marginTop="16dp"
            android:text="Correo institucional" />

        <EditText
            android:id="@+id/txtCorreo"
            style="@style/Campo"
            android:hint="matricula@utcj.edu.mx"
            android:inputType="textEmailAddress" />

        <TextView
            style="@style/Etiqueta"
            android:layout_marginTop="16dp"
            android:text="Contraseña" />

        <EditText
            android:id="@+id/txtContrasena"
            style="@style/Campo"
            android:hint="Mínimo 6 caracteres"
            android:inputType="textPassword" />

        <TextView
            style="@style/Etiqueta"
            android:layout_marginTop="16dp"
            android:text="Confirmar contraseña" />

        <EditText
            android:id="@+id/txtConfirmar"
            style="@style/Campo"
            android:hint="Repite tu contraseña"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/btnRegistrar"
            style="@style/BotonPrimario"
            android:layout_marginTop="24dp"
            android:text="Crear cuenta" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Ya tienes cuenta?"
                android:textColor="@color/texto_suave"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtIniciaSesion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="Inicia sesión"
                android:textColor="@color/primario"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
