<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla para crear cuenta (no esta en el Figma, usa el mismo estilo del Login) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".Registro">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="60dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="Logo de StudyGest"
            android:src="@drawable/logo_studygest" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.02"
            android:text="Crear cuenta"
            android:textColor="@color/texto"
            android:textSize="28sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:text="Usa tu correo de la escuela"
            android:textColor="@color/texto_suave"
            android:textSize="14sp" />

        <TextView
            style="@style/Etiqueta"
            android:layout_marginTop="32dp"
            android:text="Nombre completo" />

        <EditText
            android:id="@+id/txtNombre"
            style="@style/Campo"
            android:hint="Ej. Ana López"
            android:inputType="textPersonName" />

        <TextView
            style="@style/Etiqueta"
            android:layout_marginTop="16dp"
            android:text="Correo institucional" />

        <EditText
            android:id="@+id/txtCorreo"
            style="@style/Campo"
            android:hint="matricula@utcj.edu.mx"
            android:inputType="textEmailAddress" />

        <TextView
            style="@style/Etiqueta"
            android:layout_marginTop="16dp"
            android:text="Contraseña" />

        <EditText
            android:id="@+id/txtContrasena"
            style="@style/Campo"
            android:hint="Mínimo 6 caracteres"
            android:inputType="textPassword" />

        <TextView
            style="@style/Etiqueta"
            android:layout_marginTop="16dp"
            android:text="Confirmar contraseña" />

        <EditText
            android:id="@+id/txtConfirmar"
            style="@style/Campo"
            android:hint="Repite tu contraseña"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/btnRegistrar"
            style="@style/BotonPrimario"
            android:layout_marginTop="24dp"
            android:text="Crear cuenta" />

        <!-- "¿Ya tienes cuenta? Inicia sesión" -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Ya tienes cuenta?"
                android:textColor="@color/texto_suave"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtIniciaSesion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="Inicia sesión"
                android:textColor="@color/primario"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
