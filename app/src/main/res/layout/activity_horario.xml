<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pantalla"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".Horario">

    <LinearLayout
        style="@style/Encabezado"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtGrupo"
                style="@style/Subtitulo"
                android:text="Sin grupo" />

            <TextView
                style="@style/Titulo"
                android:text="Mi horario" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnMaterias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_translucido"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="Materias"
            android:textColor="@color/sobre_primario"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/chipLun"
            style="@style/Chip"
            android:text="Lun" />

        <TextView
            android:id="@+id/chipMar"
            style="@style/Chip"
            android:text="Mar" />

        <TextView
            android:id="@+id/chipMie"
            style="@style/Chip"
            android:text="Mié" />

        <TextView
            android:id="@+id/chipJue"
            style="@style/Chip"
            android:text="Jue" />

        <TextView
            android:id="@+id/chipVie"
            style="@style/Chip"
            android:text="Vie" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lvClases"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="12dp"
            android:paddingStart="24dp"
            android:paddingTop="4dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp"
            android:scrollbarStyle="outsideOverlay" />

        <TextView
            android:id="@+id/txtVacio"
            style="@style/EstadoVacio"
            android:text="No hay clases este día"
            android:visibility="gone" />
    </FrameLayout>

    <include layout="@layout/barra_navegacion" />

</LinearLayout>
