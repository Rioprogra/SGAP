<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_barra_navegacion"
    android:elevation="12dp"
    android:gravity="bottom"
    android:orientation="horizontal"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/navInicio"
        style="@style/NavBoton"
        android:contentDescription="Inicio">

        <ImageView
            android:id="@+id/icoInicio"
            style="@style/NavIcono"
            android:src="@drawable/ic_inicio" />

        <TextView
            android:id="@+id/txtNavInicio"
            style="@style/NavTexto"
            android:text="Inicio" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navGrupo"
        style="@style/NavBoton"
        android:contentDescription="Grupos">

        <ImageView
            android:id="@+id/icoGrupo"
            style="@style/NavIcono"
            android:src="@drawable/ic_grupo" />

        <TextView
            android:id="@+id/txtNavGrupo"
            style="@style/NavTexto"
            android:text="Grupos" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navIA"
        style="@style/NavBoton"
        android:contentDescription="Asistente IA">

        <ImageView
            android:id="@+id/icoIA"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_gemini_circulo"
            android:elevation="4dp"
            android:importantForAccessibility="no"
            android:padding="12dp"
            android:src="@drawable/ic_chispa"
            android:tint="@color/white" />

        <TextView
            android:id="@+id/txtNavIA"
            style="@style/NavTexto"
            android:text="Gemini"
            android:textColor="@color/ia_medio"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navHorario"
        style="@style/NavBoton"
        android:contentDescription="Horario">

        <ImageView
            android:id="@+id/icoHorario"
            style="@style/NavIcono"
            android:src="@drawable/ic_horario" />

        <TextView
            android:id="@+id/txtNavHorario"
            style="@style/NavTexto"
            android:text="Horario" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navPerfil"
        style="@style/NavBoton"
        android:contentDescription="Perfil">

        <ImageView
            android:id="@+id/icoPerfil"
            style="@style/NavIcono"
            android:src="@drawable/ic_perfil" />

        <TextView
            android:id="@+id/txtNavPerfil"
            style="@style/NavTexto"
            android:text="Perfil" />
    </LinearLayout>

</LinearLayout>
