<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.StudyGest" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primario</item>
        <item name="colorOnPrimary">@color/sobre_primario</item>
        <item name="colorSecondary">@color/secundario</item>
        <item name="colorPrimaryContainer">@color/primario_suave</item>
        <item name="colorOnPrimaryContainer">@color/primario</item>
        <item name="colorSurface">@color/superficie</item>
        <item name="colorOnSurface">@color/texto</item>
        <item name="android:colorBackground">@color/fondo</item>
        <item name="colorError">@color/error</item>
        <item name="android:datePickerDialogTheme">@style/Calendario</item>
    </style>

    <style name="Calendario" parent="ThemeOverlay.Material3.Dialog">
        <item name="android:colorAccent">@color/primario</item>
        <item name="colorAccent">@color/primario</item>
        <item name="colorPrimary">@color/primario</item>
        <item name="colorSecondary">@color/primario</item>
    </style>

    <style name="Etiqueta">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Campo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/bg_campo</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textColorHint">@color/placeholder</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="BotonPrimario" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/primario</item>
        <item name="android:textColor">@color/sobre_primario</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/texto_suave</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="NavBoton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="NavIcono">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/texto_suave</item>
    </style>

    <style name="NavTexto">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/texto_suave</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Avatar">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:background">@drawable/bg_avatar</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/sobre_primario</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Opcion">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_opcion</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">@color/texto_suave</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Regresar">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_translucido</item>
        <item name="android:contentDescription">Regresar</item>
        <item name="android:text">←</item>
        <item name="android:textColor">@color/sobre_primario</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="Encabezado">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_encabezado</item>
        <item name="android:elevation">6dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingBottom">24dp</item>
    </style>

    <style name="EncabezadoBarra" parent="Encabezado">
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">20dp</item>
    </style>

    <style name="EstadoVacio">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:drawableTop">@drawable/ic_vacio</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:drawableTint">@color/primario</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">32dp</item>
        <item name="android:paddingEnd">32dp</item>
        <item name="android:textColor">@color/texto_suave</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="BotonGemini" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="backgroundTint">#33FFFFFF</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="iconSize">18dp</item>
        <item name="cornerRadius">999dp</item>
    </style>

    <style name="Fab" parent="Widget.Material3.ExtendedFloatingActionButton.Icon.Primary">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">bottom|end</item>
        <item name="android:layout_marginEnd">20dp</item>
        <item name="android:layout_marginBottom">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="backgroundTint">@color/primario</item>
        <item name="android:textColor">@color/sobre_primario</item>
        <item name="iconTint">@color/sobre_primario</item>
        <item name="icon">@drawable/ic_agregar</item>
    </style>

    <style name="TituloBarra">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:textColor">@color/sobre_primario</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <style name="TituloSeccion">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="LinkSeccion">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">@color/primario</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Dato">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_tarjeta</item>
        <item name="android:elevation">3dp</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <style name="DatoNumero">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/primario</item>
    </style>

    <style name="DatoTexto">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/texto_suave</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Subtitulo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/sobre_primario_suave</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Titulo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/sobre_primario</item>
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
</resources>
